# Docker Compose and PostgreSQL
KNOWLEDGE_ENV_FILE=.env.dev
KNOWLEDGE_IMAGE=elice-techblog-rag-knowledge:latest
KNOWLEDGE_PORT=8080
APP_ENV=dev
DATABASE_URL=postgresql://knowledge:CHANGE_ME@postgres:5432/knowledge
RAG_HOST_DATABASE_URL=postgresql://knowledge:CHANGE_ME@127.0.0.1:5432/knowledge
POSTGRES_USER=knowledge
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=knowledge

# Model choices refer to models.json; the key is shared by Elice Serverless models.
MODEL_CATALOG_FILE=models.json
ANSWER_MODEL_PROFILE=
EMBEDDING_MODEL_PROFILE=
ELICE_API_KEY=

# MLflow and evaluation. setup fills the experiment and selected judges.
MLFLOW_ENABLED=true
MLFLOW_TRACKING_URI=http://MLFLOW_HOST:5000
RAG_HOST_MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=
MLFLOW_TRACKING_TOKEN=
MLFLOW_CRYPTO_KEK_PASSPHRASE=
MLFLOW_EXPERIMENT_NAME=elice-techblog-rag-evaluation
QA_MLFLOW_EXPERIMENT_NAME=elice-techblog-rag-evaluation
EVALUATION_JUDGES_ENABLED=true
EVALUATION_JUDGE_RATERS=
PROMPT_ALIAS=development

# Code login, evaluation API and optional read-only MCP access.
ADMIN_ACCESS_CODE=
AUTH_SESSION_SECRET=
EVALUATION_API_TOKEN=
MCP_API_TOKEN=

# Only needed if multiple indexes match the selected embedding model.
QA_CORPUS_SNAPSHOT_ID=
QA_CHUNK_POLICY_KEY=
