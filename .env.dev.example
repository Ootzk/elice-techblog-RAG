# Copy to .env.dev for development.
# Initial DB setup: follow README.md before starting API and worker.
KNOWLEDGE_ENV_FILE=.env.dev
KNOWLEDGE_IMAGE=elice-techblog-rag-knowledge:latest
KNOWLEDGE_PORT=8080
APP_ENV=dev

# Container-accessible endpoints. No implicit fallback between environments.
DATABASE_URL=postgresql://knowledge:CHANGE_ME@postgres:5432/knowledge
# Host-run CLI connection; use the same credentials as DATABASE_URL.
RAG_HOST_DATABASE_URL=postgresql://knowledge:CHANGE_ME@127.0.0.1:5432/knowledge
# Used only by compose.dev.yaml. Keep PASSWORD in sync with DATABASE_URL.
POSTGRES_USER=knowledge
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=knowledge
EMBEDDING_BACKEND=elice-serverless
EMBEDDING_BASE_URL=https://EMBEDDING_HOST/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_MODEL_REVISION=
ELICE_API_KEY=
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_BATCH_SIZE=16
EMBEDDING_DIMENSIONS=1536

MLFLOW_ENABLED=true
# Compose dev enables dimension-specific Gold/Iron Judges; enable for host workers too.
EVALUATION_JUDGES_ENABLED=true
# Comma-separated selected judge profile names; register scorers before evaluation.
EVALUATION_JUDGE_RATERS=
MLFLOW_TRACKING_URI=http://MLFLOW_HOST:5000
# Set only when the host CLI and containers need different addresses.
RAG_HOST_MLFLOW_TRACKING_URI=
# Required only when starting a local MLflow server.
MLFLOW_CRYPTO_KEK_PASSPHRASE=
MLFLOW_EXPERIMENT_NAME=elice-techblog-rag-connectivity
# Optional MLflow authentication; choose the method supported by your server.
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=
MLFLOW_TRACKING_TOKEN=
MLFLOW_HTTP_REQUEST_TIMEOUT=10
MLFLOW_HTTP_REQUEST_MAX_RETRIES=0
# Per process: 2 records x up to 4 dimensions = at most 8 concurrent Judge calls.
MLFLOW_GENAI_EVAL_MAX_WORKERS=2
MLFLOW_GENAI_EVAL_MAX_SCORER_WORKERS=4
MLFLOW_SUPPRESS_PRINTING_URL_TO_STDOUT=true

# Ingest only; no embedding or MLflow calls are made by this command.
CRAWL_INTERVAL_SECONDS=0.5
CRAWL_TIMEOUT_SECONDS=30
CRAWL_RETRIES=2
CRAWL_MAX_PAGES=100
CORPUS_MIN_DOCUMENTS=20

# Elice Serverless OpenAI-compatible Chat Completions. Configure all three to enable QA.
# Copy the /v1 base URL and model name from the chosen model's API panel.
GENERATION_BASE_URL=
GENERATION_MODEL=
GENERATION_TIMEOUT_SECONDS=90
QA_MAX_CONTEXT_TOKENS=8192
# Optional: only set parameters supported by the selected model.
# GENERATION_TEMPERATURE=0
# GENERATION_MAX_OUTPUT_TOKENS=1024
# GENERATION_TOKEN_LIMIT_FIELD=max_completion_tokens

# Code login: init-db registers ADMIN_ACCESS_CODE once, guest codes come from /admin/authentication.
# Generate independent random values (admin >=20 chars, session secret >=32 chars).
ADMIN_ACCESS_CODE=
AUTH_SESSION_SECRET=
EVALUATION_API_TOKEN=
# Read-only MCP endpoint (/mcp) for the same search tools; blank disables it (404). >=20 chars.
MCP_API_TOKEN=
CHAT_SESSION_HOURS=168
CHAT_LOGIN_ATTEMPTS_PER_MINUTE=10
QA_HISTORY_PAIRS=3
QA_HISTORY_TOKENS=2048
# Agentic RAG: max keyword/meaning search calls per question; paid calls <= this + 1 answer call.
QA_AGENT_MAX_TOOL_CALLS=4
# MLflow Prompt Registry alias for new QA profiles; bundled templates are used if unavailable.
PROMPT_ALIAS=development
WORKER_LEASE_SECONDS=300
QA_MLFLOW_EXPERIMENT_NAME=elice-techblog-rag-evaluation
QA_WORKER_CONCURRENCY=1


# Optional corpus and chunk policy selectors; leave blank when one matching index exists.
QA_CORPUS_SNAPSHOT_ID=
QA_CHUNK_POLICY_KEY=
