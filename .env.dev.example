# Copy to .env.dev for development.
# docker compose --env-file .env.dev -f compose.yaml -f compose.dev.yaml up --build -d
KNOWLEDGE_ENV_FILE=.env.dev
KNOWLEDGE_PORT=8080
APP_ENV=dev

# Container-accessible endpoints. No implicit fallback between environments.
DATABASE_URL=postgresql://knowledge:CHANGE_ME@postgres:5432/knowledge
# Used only by compose.dev.yaml. Keep PASSWORD in sync with DATABASE_URL.
POSTGRES_USER=knowledge
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=knowledge
EMBEDDING_BACKEND=ollama
EMBEDDING_BASE_URL=http://OLLAMA_HOST:11434
EMBEDDING_MODEL=bge-m3
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_BATCH_SIZE=16
EMBEDDING_DIMENSIONS=1024

MLFLOW_ENABLED=true
MLFLOW_TRACKING_URI=http://MLFLOW_HOST:5000
MLFLOW_EXPERIMENT_NAME=elice-techblog-rag-connectivity
# Optional MLflow authentication; choose the method supported by your server.
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=
MLFLOW_TRACKING_TOKEN=
MLFLOW_HTTP_REQUEST_TIMEOUT=10
MLFLOW_HTTP_REQUEST_MAX_RETRIES=0
MLFLOW_SUPPRESS_PRINTING_URL_TO_STDOUT=true

# Ingest only; no embedding or MLflow calls are made by this command.
CRAWL_INTERVAL_SECONDS=0.5
CRAWL_TIMEOUT_SECONDS=30
CRAWL_RETRIES=2
CRAWL_MAX_PAGES=100
CORPUS_MIN_DOCUMENTS=20

# Elice Serverless OpenAI-compatible Chat Completions. Configure all three to enable QA.
# Copy the /v1 base URL and model name from the chosen model's API panel.
GENERATION_BASE_URL=
GENERATION_API_KEY=
GENERATION_MODEL=
GENERATION_TIMEOUT_SECONDS=90
QA_MAX_CONTEXT_TOKENS=8192
# Optional: only set parameters supported by the selected model.
# GENERATION_TEMPERATURE=0
# GENERATION_MAX_OUTPUT_TOKENS=1024
# GENERATION_TOKEN_LIMIT_FIELD=max_completion_tokens
