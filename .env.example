# Production configuration for Elice Cloud
KNOWLEDGE_ENV_FILE=.env
KNOWLEDGE_IMAGE=ghcr.io/ootzk/elice-techblog-rag-knowledge:v1.0.0
KNOWLEDGE_PORT=8080
APP_ENV=prod
FORWARDED_ALLOW_IPS=127.0.0.1
DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/knowledge

# Model choices refer to models.json; the key is shared by Elice Serverless models.
MODEL_CATALOG_FILE=models.json
ANSWER_MODEL_PROFILE=
EMBEDDING_MODEL_PROFILE=
ELICE_API_KEY=

# MLflow and evaluation
MLFLOW_ENABLED=true
MLFLOW_TRACKING_URI=https://MLFLOW_HOST
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=
MLFLOW_TRACKING_TOKEN=
MLFLOW_EXPERIMENT_NAME=elice-techblog-rag-evaluation
QA_MLFLOW_EXPERIMENT_NAME=elice-techblog-rag-evaluation
EVALUATION_JUDGES_ENABLED=false
EVALUATION_JUDGE_RATERS=
PROMPT_ALIAS=production

# Code login, evaluation API and optional read-only MCP access.
ADMIN_ACCESS_CODE=
AUTH_SESSION_SECRET=
EVALUATION_API_TOKEN=
MCP_API_TOKEN=

# Only needed if multiple indexes match the selected embedding model.
QA_CORPUS_SNAPSHOT_ID=
QA_CHUNK_POLICY_KEY=
